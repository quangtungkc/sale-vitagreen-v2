{
  "name": "sale-vitagreen-v2-desktop",
  "version": "2.8.8",
  "description": "Ứng dụng desktop CRM và KPI SALE VITAGREEN V2",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.16.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "build": {
    "appId": "com.vitagreen.salev2",
    "productName": "SALE VITAGREEN V2",
    "win": { "signAndEditExecutable": false },
    "mac": { "target": ["zip"], "category": "public.app-category.business" },
    "directories": { "output": "release" },
    "files": ["**/*", "!release/**"],
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  }
}
